# Copy thành web/.env:  Copy-Item .env.example .env
#
# URL tới Directus API.
# ⚠️ Vite NHÚNG biến này lúc BUILD, không đọc lúc chạy.
#    Đổi giá trị là phải `npm run build` lại, nếu không bản deploy
#    vẫn trỏ về địa chỉ cũ.
#
#   local      : http://localhost:8055
#   production : https://api.tenmien.vn
VITE_DIRECTUS_URL=http://localhost:8055
