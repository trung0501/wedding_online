# ============================================================
#  Copy file này thành .env rồi điền giá trị thật.
#      Copy-Item .env.example .env
#
#  KHI LÊN VPS: tạo thêm .env.production với cùng bộ khoá nhưng
#  giá trị của server, rồi chạy script kèm:
#      node --env-file=.env.production directus/setup-permissions.mjs
#  Cả hai file đều đã được .gitignore chặn, không lọt lên Git.
# ============================================================

# ---------- PostgreSQL ----------
DB_DATABASE=wedding
DB_USER=wedding
DB_PASSWORD=doi-mat-khau-nay

# ---------- Directus ----------
# Sinh chuỗi ngẫu nhiên 64 ký tự cho mỗi biến (KHÔNG dùng lại giữa local và production):
#   -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
DIRECTUS_KEY=thay-bang-chuoi-ngau-nhien
DIRECTUS_SECRET=thay-bang-chuoi-ngau-nhien

# Tài khoản admin đầu tiên. Các script trong directus/ đăng nhập bằng cặp này.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay

# URL của chính Directus.
#   local      : http://localhost:8055
#   production : https://api.tenmien.vn
PUBLIC_URL=http://localhost:8055

# Domain của frontend được phép gọi API. Sai là trình duyệt chặn sạch.
# Cũng là cổng mà script chụp thumbnail dùng (web/tools/gen-thumbnails.mjs).
#   local      : http://localhost:5173
#   production : https://tenmien.vn
CORS_ORIGIN=http://localhost:5173

# ---------- Ảnh (có giá trị mặc định, chỉ khai khi muốn đổi) ----------
# Số lượt resize chạy song song. VPS 1 core nên để 2, từ 2 core trở lên để 4.
# ASSETS_TRANSFORM_MAX_CONCURRENT=4
# ASSETS_TRANSFORM_MAX_OPERATIONS=5
# ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION=6000
# ASSETS_CACHE_TTL=30d

# ---------- Dùng cho script ----------
# Địa chỉ frontend, dùng để dựng link trong tin nhắn gửi khách
# (directus/create-client-account.mjs). Thiếu thì mặc định localhost:5173 —
# gửi nhầm link localhost cho khách là mất mặt.
SITE_URL=http://localhost:5173

# Không bắt buộc: trỏ script tới một Directus khác mà không đổi PUBLIC_URL.
# DIRECTUS_URL=https://api.tenmien.vn

# Không bắt buộc: dùng static token thay cho ADMIN_EMAIL/ADMIN_PASSWORD.
# DIRECTUS_TOKEN=
