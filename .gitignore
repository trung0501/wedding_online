# dependencies
node_modules/

# build output
dist/
web/dist/
*.timestamp-*.mjs

# env / secrets
# Chặn cả .env.production, .env.staging… — chỉ chừa file .example không chứa mật khẩu.
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example
*.local

# Directus runtime data
data/
directus/uploads/*
!directus/uploads/.gitkeep
directus/extensions/*
!directus/extensions/.gitkeep

# bản sao lưu phân quyền (sinh tự động, có dấu thời gian)
directus/permissions-backup-*.json
directus/permissions-current.json

# logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
